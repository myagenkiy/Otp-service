# ============================================
# НАСТРОЙКИ OTP SERVICE
# Скопируйте этот файл как .env и заполните
# ============================================

# ---------- БАЗА ДАННЫХ (ОБЯЗАТЕЛЬНО!) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otp_db
DB_USERNAME=postgres
DB_PASSWORD=ВАШ_ПАРОЛЬ_ОТ_POSTGRESQL

# ---------- JWT ----------
JWT_SECRET=mySuperSecretKeyForJWT2024
JWT_EXPIRATION_HOURS=1

# ---------- TELEGRAM (ОПЦИОНАЛЬНО) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- EMAIL (ОПЦИОНАЛЬНО) ----------
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------- OTP НАСТРОЙКИ ----------
OTP_CODE_LENGTH=6
OTP_LIFETIME_SECONDS=300

# ---------- СЕРВЕР ----------
SERVER_PORT=8080